# AI Scholar Hub Release G — warm PROD promotion contract

RELEASE_NAME=release-g
DEV_ROOT=/opt/aischolarhub
PROD_ROOT=/opt/scholarhub

EXPECTED_API_IMAGE=seeds.azurecr.io/aischolarhub-custom:dev-20260915-062236b2c-release-g-final-ui-fix
EXPECTED_API_DIGEST=sha256:9085cc0ed692393a550e454ba1ddff549febbdbde9969b22573b8436d297e1d2

ROLLBACK_API_IMAGE=seeds.azurecr.io/aischolarhub-custom:dev-20260914-b019d6a33-release-f-blob-v2
IMAGE_REPO=seeds.azurecr.io/aischolarhub-custom
RETAIN_API_IMAGES=

PROD_API_CONTAINER=aih-prod-api
PROD_MODEL_ROUTER_CONTAINER=aih-prod-model-router
PROD_SEARXNG_CONTAINER=aih-prod-searxng
API_SERVICE=api

# PROD environment/config remains PROD-owned.
PROMOTE_LIBRECHAT=0
PROMOTE_COMPOSE=0

MIGRATIONS_DIR=/opt/aischolarhub/release-migrations/release-g

EXPECTED_ACADEMIC_AGENT_COUNT=3
EXPECTED_WEBSEARCH_PERSONA_COUNT=5
MIN_CLASS_A=1
MIN_CLASS_B=1

REQUIRED_PROD_ENV_KEYS=SEARXNG_INSTANCE_URL,ASH_MODEL_ROUTER_ENABLED,ASH_GOOGLE_API_KEYS,ASH_GROQ_API_KEYS,ASH_OPENROUTER_API_KEYS,ASH_CLOUDFLARE_ACCOUNT_IDS,ASH_CLOUDFLARE_API_TOKENS

# Explicit Release G migration declarations
MIGRATION_ENV_CONFIG=NONE
MIGRATION_MONGO_INDEX=NONE
MIGRATION_DATA_BOOTSTRAP=010-support-manuals-sync.sh
MIGRATION_STORAGE=NONE
MIGRATION_POST_DEPLOY=scripts/release-tooling/verify-release.sh
MIGRATION_ROLLBACK=ROLLBACK_API_IMAGE
