# AI Scholar Hub Release E deployment contract.
# Copy to release-e.env and replace values only after DEV UAT passes.

RELEASE_NAME=release-e
DEV_ROOT=/opt/aischolarhub
PROD_ROOT=/opt/scholarhub

# Immutable DEV-tested image promoted unchanged to PROD.
EXPECTED_API_IMAGE=seeds.azurecr.io/aischolarhub-custom:REPLACE_WITH_RELEASE_E_TAG
EXPECTED_API_DIGEST=sha256:REPLACE_WITH_DIGEST

# Keep at least one known-good rollback image.
ROLLBACK_API_IMAGE=seeds.azurecr.io/aischolarhub-custom:dev-20260912-c33a0b62c-release-d-uat-v3
IMAGE_REPO=seeds.azurecr.io/aischolarhub-custom

# Optional additional full image references to retain locally, comma-separated.
# Useful when DEV and PROD intentionally use different candidate images.
RETAIN_API_IMAGES=

PROD_API_CONTAINER=aih-prod-api
PROD_MODEL_ROUTER_CONTAINER=aih-prod-model-router
PROD_SEARXNG_CONTAINER=aih-prod-searxng
API_SERVICE=api

# Promote bind-mounted files only when they are intentional release artifacts.
PROMOTE_LIBRECHAT=0
PROMOTE_COMPOSE=0
# LIBRECHAT_SOURCE=/opt/aischolarhub/release-artifacts/release-e/librechat.yaml
# COMPOSE_SOURCE=/opt/aischolarhub/release-artifacts/release-e/docker-compose.yml

# Release-specific idempotent migrations.
MIGRATIONS_DIR=/opt/aischolarhub/release-migrations/release-e

EXPECTED_ACADEMIC_AGENT_COUNT=3
EXPECTED_WEBSEARCH_PERSONA_COUNT=5
MIN_CLASS_A=1
MIN_CLASS_B=1

# Presence checks only; values are never printed.
REQUIRED_PROD_ENV_KEYS=SEARXNG_INSTANCE_URL,ASH_MODEL_ROUTER_ENABLED,ASH_GOOGLE_API_KEYS,ASH_GROQ_API_KEYS,ASH_OPENROUTER_API_KEYS,ASH_CLOUDFLARE_ACCOUNT_IDS,ASH_CLOUDFLARE_API_TOKENS
