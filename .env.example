# Copy to .env, fill in the placeholders, NEVER commit the real file.
# Used both for local testing and on the VM (deploy-vm.sh creates this from
# .env.example automatically, then pauses for you to fill in the values
# that need your real domain/OAuth credentials).

# ---- Server ----------------------------------------------------------------
HOST=0.0.0.0
PORT=3080
DOMAIN_CLIENT=https://aischolarhub.yourcollege.edu
DOMAIN_SERVER=https://aischolarhub.yourcollege.edu

# ---- MongoDB (LibreChat's actual primary datastore) -------------------------
# Self-hosted mongo container on the Compose network, never exposed publicly.
MONGO_URI=mongodb://mongodb:27017/LibreChat

# ---- Meilisearch (conversation full-text search, NOT vector RAG) ------------
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=REPLACE_WITH_GENERATED_KEY   # scripts/generate-secrets.sh
MEILI_NO_ANALYTICS=true
SEARCH=true

# ---- RAG API / pgvector (real document RAG — separate from Meilisearch) -----
RAG_API_URL=http://rag_api:8000
RAG_PORT=8000
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD

# ---- Google Gemini ------------------------------------------------------
# Phase 3 switched to a custom OpenAI-compatible endpoint (config/librechat.yaml
# defines it as "Google Gemini") instead of the native `google` endpoint used
# earlier — so `google` is deliberately NOT in ENDPOINTS below, to avoid two
# duplicate Gemini entries in the model picker. GEMINI_API_KEY here matches
# the ${GEMINI_API_KEY} reference in config/librechat.yaml's custom endpoint.
ENDPOINTS=agents
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY

# ---- Message rate limiting (native — Automated Moderation system) -----------
# This is the actual mechanism for "50 messages/day, 10 messages/10 minutes."
# Each limiter (IP vs USER) only supports ONE window, so the two numbers from
# the brief map onto two different controls rather than one:
#   - Burst protection (10 msgs / 10 min) -> the USER limiter below, which
#     LibreChat actually enforces per request.
#   - "50/day" -> handled instead by the token-credit balance system in
#     config/librechat.yaml (balance.startBalance + daily autoRefill), which
#     caps total spend/day rather than raw message count — a more accurate
#     cost control anyway, since a 50-message cap doesn't stop one giant
#     50,000-token message.
# KNOWN CAVEAT: there's an open, unresolved report (danny-avila/LibreChat
# discussion #11916) that these limiters sometimes don't fire on the main
# chat endpoint in some versions/configs. Test it after deploy — send 11
# rapid messages as a test student account and confirm the 11th is rejected
# — don't just trust the config.
LIMIT_MESSAGE_USER=true
MESSAGE_USER_MAX=10
MESSAGE_USER_WINDOW=10          # minutes
LIMIT_MESSAGE_IP=true
MESSAGE_IP_MAX=30               # generous shared-IP ceiling (dorm wifi, labs)
MESSAGE_IP_WINDOW=10            # minutes

# ---- Security & tokens (generate fresh — never reuse the examples) ----------
JWT_SECRET=REPLACE_WITH_GENERATED_HEX32
JWT_REFRESH_SECRET=REPLACE_WITH_GENERATED_HEX32
CREDS_KEY=REPLACE_WITH_GENERATED_HEX32
CREDS_IV=REPLACE_WITH_GENERATED_HEX16

# ---- Registration & SSO ------------------------------------------------------
# Domain restriction is NOT an .env variable — it's set in librechat.yaml
# under registration.allowedDomains. This just controls whether the
# registration/login flows are enabled at all.
ALLOW_REGISTRATION=true
ALLOW_EMAIL_LOGIN=true
ALLOW_SOCIAL_LOGIN=true
ALLOW_SOCIAL_REGISTRATION=true

# Google OAuth SSO client — a DIFFERENT credential pair from GEMINI_API_KEY
# above. GEMINI_API_KEY is billing/inference for Gemini itself. These below
# are an OAuth 2.0 Client ID/Secret from Google Cloud Console, used purely
# for institutional login. Mixing them up is a common and confusing
# mistake — keep them clearly separate.
GOOGLE_CLIENT_ID=REPLACE_WITH_OAUTH_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_WITH_OAUTH_CLIENT_SECRET
GOOGLE_CALLBACK_URL=/oauth/google/callback

# ---- Token credit / quota system (native to LibreChat — see librechat.yaml) --
# The default balance for new registrations lives in config/librechat.yaml's
# `balance` object. Per-student overrides by role (200k undergrad / 1M PhD)
# come from your roster CSV via scripts/bulk_import.py — NOT set here.
