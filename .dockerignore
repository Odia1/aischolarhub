# ============================================================
# Git / IDE / OS
# ============================================================
**/.git
**/.git/**
**/.circleci
**/.editorconfig
**/.DS_Store
**/.vscode

# ============================================================
# Dependencies / generated package data
# ============================================================
**/node_modules
**/.npm
**/.cache
**/.turbo
**/.eslintcache

# ============================================================
# Runtime databases / indexes
# NEVER include these in the application image
# ============================================================
data-node/
meili_data*/
pgvector_data/
mongo_data/
ollama_data/

# ============================================================
# Runtime application data
# These are bind-mounted by docker-compose
# ============================================================
uploads/
logs/
backups/

# ============================================================
# Docker / deployment artifacts
# ============================================================
Dockerfile*
docker-compose*.yml
docker-compose*.yaml
deploy-compose.yml

# ============================================================
# Documentation / development-only material
# ============================================================
docs/

# Environment / secrets
.env
*.env
.env.*
!.env.example
gemini-proxy/__pycache__
gemini-proxy/*.pyc

# Temp/editor files
**/*~